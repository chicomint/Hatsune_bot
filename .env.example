DISCORD_TOKEN=
DISCORD_CLIENT_ID=
MONGODB_URI=
OWNER_ID=

OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Existing osu! credentials are shared by /osu, /osum, and .osum.

BOT_STATUS=online
BOT_ACTIVITY_TYPE=LISTENING
BOT_ACTIVITY_NAME=Hatsune bot
BOT_ACTIVITY_URL=https://chiko.cc/

COUNTDOWN_CHECK_SECONDS=60
LINK_WARNING_COOLDOWN_SECONDS=30
LINK_WARNING_DELETE_SECONDS=5
OSU_COMMAND_COOLDOWN_SECONDS=5
# /osum and .osum share a per-user cooldown using this setting.

# Opt-in per server with /chikochan enable channel:<channel>
CHIKOCHAN_BASE_URL=https://boards.chiko.cc
CHIKOCHAN_POLL_SECONDS=30
# Re-read unchanged threads to catch count-neutral changes (seconds)
CHIKOCHAN_RECONCILE_SECONDS=600
